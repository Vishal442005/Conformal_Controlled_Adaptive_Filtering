<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Active Model Tag Header -->
        <TextView
            android:id="@+id/tvActiveModelTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="10dp"
            android:text="Active Model: Proposed CCAF-DB [PROPOSED]"
            android:textColor="@color/accent_emerald"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Live Dual-Waveform (Cyan: Microphone Input | Amber: Model Filtered):"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Real-time Dual Waveform Canvas -->
        <com.research.ccaf.ui.DualWaveformView
            android:id="@+id/liveWaveformView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="6dp" />

        <!-- Metrics HUD (8 Telemetry Parameters) -->
        <TextView
            android:id="@+id/tvMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:gravity="center"
            android:padding="10dp"
            android:text="Step Size μ: 0.0500 | Coverage: 90.0% | Winkler: 0.799\nERLE: +28.4 dB | Surge: 0.82 σ | Dead-band: SLEEP | FLOPs: 133"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <!-- Live Record / Stop Toggle Button -->
        <Button
            android:id="@+id/btnRecordToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#0284C7"
            android:text="START LIVE RECORDING"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Tap Start Live Recording to begin microphone capture."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Instant Audio Shifter Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Instant Audio Shifter (Switch Live While Playing):"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- A/B Seamless Switcher Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#090E17"
                android:padding="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnListenReal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0F766E"
                    android:enabled="false"
                    android:text="🔈 Real Mic Audio"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnListenModel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#334155"
                    android:enabled="false"
                    android:text="🎧 Model Output"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Play / Stop Seamless Playback Button -->
            <Button
                android:id="@+id/btnPlaySeamlessLive"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0284C7"
                android:enabled="false"
                android:text="▶️ PLAY RECORDING (ENABLES LIVE SHIFTING)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#059669"
                android:enabled="false"
                android:text="💾 SAVE PROCESSED AUDIO TO STORAGE (.WAV)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>